<?php

/**
 * @file
 * Popular Education theme: all data shaping happens here, Twig stays dumb.
 *
 * One _pe_theme_prepare_<bundle>() builder per content type feeds a single
 * 'pe' variable to the node templates.
 */

use Drupal\Core\Url;
use Drupal\file\FileInterface;
use Drupal\link\LinkItemInterface;
use Drupal\media\MediaInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function pe_theme_preprocess_page(array &$variables): void {
  $variables['pe_logo'] = '/' . \Drupal::service('extension.list.theme')->getPath('pe_theme') . '/images/logo-march.png';
  $variables['pe_action_art'] = '/' . \Drupal::service('extension.list.theme')->getPath('pe_theme') . '/images/action-figures.jpg';

  if (!empty($variables['is_front'])) {
    $node_storage = \Drupal::entityTypeManager()->getStorage('node');
    $count = fn(string $bundle): int => (int) $node_storage->getQuery()
      ->condition('type', $bundle)
      ->condition('status', 1)
      ->accessCheck(TRUE)
      ->count()
      ->execute();
    $embed = fn(string $view): array => [
      '#type' => 'view',
      '#name' => $view,
      '#display_id' => 'embed_1',
    ];
    $variables['pe_front'] = [
      'org_count' => $count('organisation'),
      'tool_count' => $count('tool'),
      'library' => $embed('library'),
      'galleries' => $embed('galleries'),
      'audio' => $embed('audio_archive'),
    ];
  }
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Favicon.ico in the theme root is picked up by core; iOS home-screen
 * icons need their own link.
 */
function pe_theme_page_attachments_alter(array &$attachments): void {
  $theme_path = '/' . \Drupal::service('extension.list.theme')->getPath('pe_theme');
  $attachments['#attached']['html_head_link'][] = [
    [
      'rel' => 'apple-touch-icon',
      'sizes' => '180x180',
      'href' => $theme_path . '/images/apple-touch-icon.png',
    ],
  ];
  // Preload the three fonts every page paints with, so the swap window
  // (and its layout shift) closes before first paint.
  foreach ([
    'anton-latin-400-normal.woff2',
    'archivo-latin-wght-normal.woff2',
    'ibm-plex-mono-latin-400-normal.woff2',
  ] as $font) {
    $attachments['#attached']['html_head_link'][] = [
      [
        'rel' => 'preload',
        'as' => 'font',
        'type' => 'font/woff2',
        'href' => $theme_path . '/dist/fonts/' . $font,
        'crossorigin' => 'anonymous',
      ],
    ];
  }
}

/**
 * Implements hook_preprocess_HOOK() for block templates.
 *
 * Node full pages and the front page render their own headings; the page
 * title block would duplicate them.
 */
function pe_theme_preprocess_block(array &$variables): void {
  if (($variables['plugin_id'] ?? '') === 'page_title_block') {
    $route = \Drupal::routeMatch()->getRouteName();
    $variables['pe_hide_title'] = $route === 'entity.node.canonical'
      || \Drupal::service('path.matcher')->isFrontPage();
  }
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function pe_theme_preprocess_node(array &$variables): void {
  $node = $variables['node'];
  if (!$node instanceof NodeInterface) {
    return;
  }
  $builder = '_pe_theme_prepare_' . $node->bundle();
  $pe = function_exists($builder) ? $builder($node) : [];
  $pe += _pe_theme_prepare_common($node);
  if (($variables['view_mode'] ?? '') === 'full') {
    $pe['related'] = _pe_theme_related($node);
  }
  $variables['pe'] = $pe;
}

/**
 * Builds the Keep learning trail for a node.
 *
 * Up to three published nodes sharing this node's first topic; falls back
 * to recent siblings of the bundle.
 *
 * @return array<int, array<string, string>>
 *   Related items: label, url, kicker.
 */
function _pe_theme_related(NodeInterface $node): array {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = [];
  if ($node->hasField('field_topics') && !$node->get('field_topics')->isEmpty()) {
    $tid = $node->get('field_topics')->target_id;
    $ids = \Drupal::database()->select('taxonomy_index', 'ti')
      ->fields('ti', ['nid'])
      ->condition('tid', $tid)
      ->condition('nid', $node->id(), '<>')
      ->orderRandom()
      ->range(0, 3)
      ->execute()
      ->fetchCol();
  }
  if (!$ids) {
    $ids = \Drupal::entityQuery('node')
      ->condition('type', $node->bundle())
      ->condition('status', 1)
      ->condition('nid', $node->id(), '<>')
      ->sort('created', 'DESC')
      ->range(0, 3)
      ->accessCheck(TRUE)
      ->execute();
  }
  $related = [];
  foreach ($storage->loadMultiple($ids) as $r) {
    if (!$r->isPublished()) {
      continue;
    }
    $related[] = [
      'label' => $r->label(),
      'url' => $r->toUrl()->toString(),
      'kicker' => $r->type->entity?->label() ?? $r->bundle(),
    ];
  }
  return $related;
}

/**
 * Shared data for every bundle: topics, attachments, provenance.
 *
 * @return array<string, mixed>
 *   Prepared values.
 */
function _pe_theme_prepare_common(NodeInterface $node): array {
  $pe = [
    'kicker' => $node->type->entity?->label() ?? $node->bundle(),
    'topics' => [],
    'attachments' => [],
    'image_url' => NULL,
    'provenance' => NULL,
  ];

  if ($node->hasField('field_topics')) {
    foreach ($node->get('field_topics')->referencedEntities() as $term) {
      $pe['topics'][] = [
        'label' => $term->label(),
        'url' => Url::fromRoute('entity.taxonomy_term.canonical', ['taxonomy_term' => $term->id()])->toString(),
      ];
    }
  }

  if ($node->hasField('field_documents')) {
    foreach ($node->get('field_documents')->referencedEntities() as $media) {
      if ($info = _pe_theme_file_info($media)) {
        $pe['attachments'][] = $info;
      }
    }
  }

  if ($node->hasField('field_images') && !$node->get('field_images')->isEmpty()) {
    $pe['image_url'] = _pe_theme_image_url($node->get('field_images')->referencedEntities()[0], 'large');
  }

  if ($node->hasField('field_audio')) {
    $pe['tracks'] = [];
    foreach ($node->get('field_audio')->referencedEntities() as $media) {
      if ($info = _pe_theme_file_info($media)) {
        $pe['tracks'][] = $info;
      }
    }
  }

  // The first PDF reads in the page; all attachments stay downloadable.
  foreach ($pe['attachments'] as $file) {
    if ($file['ext'] === 'PDF') {
      $pe['pdf_viewer'] = $file;
      break;
    }
  }

  if ($node->hasField('field_legacy_id') && !$node->get('field_legacy_id')->isEmpty()) {
    $legacy = $node->get('field_legacy_id')->value;
    $pe['provenance'] = t('Recovered from populareducation.org.za (@path) via the Internet Archive.', [
      '@path' => $legacy,
    ]);
    $pe['wayback_url'] = 'https://web.archive.org/web/2023/https://www.populareducation.org.za' . $legacy;
  }

  // An honest note when the archive preserved the page but not its substance.
  $body_len = $node->hasField('body')
    ? mb_strlen(trim(strip_tags((string) $node->get('body')->value)))
    : 0;
  $has_media = $pe['attachments'] || !empty($pe['tracks']) || $pe['image_url'];
  if ($body_len < 40 && !$has_media && !empty($pe['wayback_url'])) {
    $pe['archive_gap'] = TRUE;
  }

  return $pe;
}

/**
 * Organisation extras: the active stamp and website link.
 *
 * @return array<string, mixed>
 *   Prepared values.
 */
function _pe_theme_prepare_organisation(NodeInterface $node): array {
  $pe = [];
  if ($node->hasField('field_active') && !$node->get('field_active')->isEmpty()) {
    $pe['active'] = (bool) $node->get('field_active')->value;
  }
  if ($node->hasField('field_website') && !$node->get('field_website')->isEmpty()) {
    $item = $node->get('field_website')->first();
    if ($item instanceof LinkItemInterface) {
      $pe['website'] = $item->getUrl()->toString();
    }
  }
  if ($node->hasField('field_regions')) {
    $pe['regions'] = array_map(
      fn($term) => $term->label(),
      $node->get('field_regions')->referencedEntities()
    );
  }
  return $pe;
}

/**
 * Gallery extras: the image figures.
 *
 * @return array<string, mixed>
 *   Prepared values.
 */
function _pe_theme_prepare_gallery(NodeInterface $node): array {
  $figures = [];
  if ($node->hasField('field_images')) {
    foreach ($node->get('field_images')->referencedEntities() as $media) {
      $url = _pe_theme_image_url($media, 'large');
      if (!$url) {
        continue;
      }
      $source = $media->get('field_media_image')->getValue()[0] ?? [];
      $w = (int) ($source['width'] ?? 0);
      $h = (int) ($source['height'] ?? 0);
      // Derivative dimensions: each style is an image_scale with upscaling
      // off, so the ratio never exceeds 1. large bounds both edges at 480;
      // wide/xl bound only the width (1090/2000).
      $scale = static fn (float $ratio): array => [
        (int) round($w * min(1.0, $ratio)),
        (int) round($h * min(1.0, $ratio)),
      ];
      $srcset = NULL;
      $dims = ['large' => NULL, 'wide' => NULL, 'xl' => NULL];
      if ($w && $h) {
        $dims['large'] = $scale(min(480 / $w, 480 / $h));
        $dims['wide'] = $scale(1090 / $w);
        $dims['xl'] = $scale(2000 / $w);
        $candidates = [];
        foreach ($dims as $style => [$dw]) {
          // Skip styles that resolve to the same width (small originals).
          $candidates[$dw] ??= _pe_theme_image_url($media, $style) . " {$dw}w";
        }
        $srcset = implode(', ', $candidates);
      }
      $figures[] = [
        'url' => $url,
        'srcset' => $srcset,
        'sizes' => '(min-width: 48rem) 18rem, 100vw',
        'width' => $dims['large'][0] ?? NULL,
        'height' => $dims['large'][1] ?? NULL,
        'full' => _pe_theme_image_url($media, 'xl'),
        'download' => _pe_theme_image_url($media, NULL),
        'pswp_w' => $dims['xl'][0] ?? NULL,
        'pswp_h' => $dims['xl'][1] ?? NULL,
        'caption' => $media->hasField('field_caption') ? $media->get('field_caption')->value : NULL,
        'credit' => $media->hasField('field_credit') ? $media->get('field_credit')->value : NULL,
        'alt' => $source['alt'] ?? '',
        'index' => count($figures) + 1,
      ];
    }
  }
  return ['figures' => $figures, 'count' => count($figures)];
}

/**
 * Audio extras: playable recordings.
 *
 * @return array<string, mixed>
 *   Prepared values.
 */
function _pe_theme_prepare_audio_item(NodeInterface $node): array {
  $pe = [];
  if ($node->hasField('field_event') && !$node->get('field_event')->isEmpty()) {
    $pe['event'] = $node->get('field_event')->value;
  }
  if ($node->hasField('field_speakers')) {
    $pe['speakers'] = array_map(
      fn($item) => $item->getString(),
      iterator_to_array($node->get('field_speakers'))
    );
  }
  return $pe;
}

/**
 * Resolves a media entity's file to url/label/extension/size.
 *
 * @return array<string, mixed>|null
 *   File info, or NULL when the media has no file.
 */
function _pe_theme_file_info(MediaInterface $media): ?array {
  $fid = $media->getSource()->getSourceFieldValue($media);
  $file = $fid ? \Drupal::entityTypeManager()->getStorage('file')->load($fid) : NULL;
  if (!$file instanceof FileInterface) {
    return NULL;
  }
  $uri = $file->getFileUri();
  return [
    'url' => \Drupal::service('file_url_generator')->generateString($uri),
    'label' => $media->label(),
    'ext' => strtoupper(pathinfo($uri, PATHINFO_EXTENSION)),
    'size' => _pe_theme_format_size((int) $file->getSize()),
  ];
}

/**
 * Compact human file size (kB/MB, one decimal).
 */
function _pe_theme_format_size(int $bytes): string {
  if ($bytes >= 1048576) {
    return round($bytes / 1048576, 1) . ' MB';
  }
  if ($bytes >= 1024) {
    return round($bytes / 1024) . ' kB';
  }
  return $bytes . ' B';
}

/**
 * URL of an image media derivative (NULL style = original file).
 */
function _pe_theme_image_url(MediaInterface $media, ?string $style_id): ?string {
  $fid = $media->getSource()->getSourceFieldValue($media);
  $file = $fid ? \Drupal::entityTypeManager()->getStorage('file')->load($fid) : NULL;
  if (!$file instanceof FileInterface) {
    return NULL;
  }
  $uri = $file->getFileUri();
  if ($style_id) {
    $style = \Drupal::entityTypeManager()->getStorage('image_style')->load($style_id);
    if ($style) {
      return $style->buildUrl($uri);
    }
  }
  return \Drupal::service('file_url_generator')->generateString($uri);
}
