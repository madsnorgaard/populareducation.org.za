{#
/**
 * @file
 * Default full node: the document. Header, topic tags, body, attachments,
 * provenance. Bundle-specific templates layer on top of this shape.
 */
#}
<article{{ attributes.addClass('node-full') }}>
  <header class="node-full__header register">
    <span class="slug">{{ pe.kicker }}</span>
    <h1 class="node-full__title">{{ label }}</h1>
    {% if pe.topics|length %}
      <ul class="node-full__topics">
        {% for topic in pe.topics %}
          <li><a href="{{ topic.url }}">{{ topic.label }}</a></li>
        {% endfor %}
      </ul>
    {% endif %}
  </header>

  {% block facts %}{% endblock %}

  <div class="node__body">
    {{ content.body }}
  </div>

  {% block extra %}{% endblock %}

  {% if pe.tracks|default([])|length %}
    <ul class="audio-list">
      {% for track in pe.tracks %}
        <li>
          <span class="slug">{{ track.label }}</span>
          <audio controls preload="none" src="{{ track.url }}"></audio>
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  {% if pe.archive_gap %}
    <aside class="archive-gap">
      <p>
        {{ 'The Internet Archive preserved this page but not its content. If you have the original material, please get in touch.'|t }}
        <a href="{{ pe.wayback_url }}" rel="external">{{ 'See the archived page'|t }} &rarr;</a>
      </p>
    </aside>
  {% endif %}

  {% if pe.pdf_viewer %}
    <section class="pdf-viewer">
      <h2 class="pdf-viewer__title">{{ 'Read it here'|t }}</h2>
      <object data="{{ pe.pdf_viewer.url }}" type="application/pdf" aria-label="{{ pe.pdf_viewer.label }}">
        <p>{{ 'Your browser does not display PDFs inline.'|t }}
          <a href="{{ pe.pdf_viewer.url }}" download>{{ 'Download @label'|t({'@label': pe.pdf_viewer.label}) }}</a>
        </p>
      </object>
    </section>
  {% endif %}

  {% if pe.attachments|length %}
    <aside class="attachments">
      <h2 class="attachments__title">{{ 'Take it with you'|t }}</h2>
      <ul>
        {% for file in pe.attachments %}
          <li>
            <a href="{{ file.url }}" download>
              <span>{{ file.label }}</span>
              <span class="attachments__ext">{{ file.ext }} &middot; {{ file.size }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </aside>
  {% endif %}

  {% if pe.related|default([])|length %}
    <nav class="keep-learning" aria-label="{{ 'Related content'|t }}">
      <h2 class="keep-learning__title">{{ 'Keep learning'|t }}</h2>
      <ul>
        {% for item in pe.related %}
          <li>
            <span class="poster__kicker">{{ item.kicker }}</span>
            <a href="{{ item.url }}">{{ item.label }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  {% endif %}

  {% if pe.provenance %}
    <footer class="provenance">{{ pe.provenance }}</footer>
  {% endif %}
</article>
