{% extends 'node.html.twig' %}
{#
/**
 * @file
 * Audio item: event and speakers above the recordings (tracks render in the
 * base template).
 */
#}
{% block extra %}
  {% if pe.event or pe.speakers|default([])|length %}
    <p class="slug">
      {% if pe.event %}{{ pe.event }}{% endif %}
      {% if pe.speakers|default([])|length %}
        {% if pe.event %} &middot; {% endif %}{{ 'Voices: @speakers'|t({'@speakers': pe.speakers|join(', ')}) }}
      {% endif %}
    </p>
  {% endif %}
{% endblock %}
