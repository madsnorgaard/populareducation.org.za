parameters:
  level: 6
  paths:
    - web/modules/custom
    - web/themes/custom
  ignoreErrors:
    # phpcs forbids @param docs on hook implementations, so the iterable
    # value type cannot be documented there.
    - '#pe_theme_preprocess_\w+\(\) has parameter \$variables#'
    - '#pe_theme_page_attachments_alter\(\) has parameter \$attachments#'
  reportUnmatchedIgnoredErrors: false
