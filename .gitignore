# Composer-managed
vendor/
web/core/
web/modules/contrib/
web/themes/contrib/
web/profiles/contrib/
web/libraries/

# Scaffolded files (regenerated by drupal-scaffold)
web/.csslintrc
web/.eslintignore
web/.eslintrc.json
web/.ht.router.php
web/.htaccess
web/autoload.php
web/example.gitignore
web/index.php
web/INSTALL.txt
web/README.md
web/robots.txt
web/update.php
web/web.config

# Track web/sites/default/ but not generated content
web/sites/*/files
web/sites/*/private
web/sites/default/settings.local.php
web/sites/default/settings.ddev.php

# Runtime data + private masters (never in git)
data/
private/*
!private/.gitkeep
backups/

# Secrets + dumps
.env
*.sql
*.sql.gz

# Editors
.idea/
.vscode/
/.editorconfig
web/sites/default/default.settings.php
web/sites/default/default.services.yml
